<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- Milliseconds between animation ticks. Lower is faster and smoother. -->
        <add key="TickIntervalMs" value="30" />
        <!-- How many seeds of each kind of lily (spider, calla, tiger, lily of the valley) are planted in the
             vase at start-up. -->
        <add key="StartingFlowersPerKind" value="1" />
        <!-- Lilies that sprout by themselves (pollination, making the window bigger) stop at this many. -->
        <add key="MaxFlowers" value="16" />
    </appSettings>
</configuration>
