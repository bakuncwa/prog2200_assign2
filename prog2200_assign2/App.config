<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- Milliseconds between animation ticks. Lower is faster and smoother. -->
        <add key="TickIntervalMs" value="30" />
        <!-- How many of each kind of flower (daisy, tulip, ASCII sprout, label bouquet) are planted at start-up. -->
        <add key="StartingFlowersPerKind" value="2" />
    </appSettings>
</configuration>
